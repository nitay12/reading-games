{
  "name": "reading-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sync-icons": "node scripts/sync-icons.mjs",
    "smoke": "esbuild scripts/smoke.mts --bundle --platform=node --format=esm | node --input-type=module"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@mdi/svg": "^7.4.47",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
